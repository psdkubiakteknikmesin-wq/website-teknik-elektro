# ─── SIPREL ELEKTRO — contoh konfigurasi ─────────────────────────────────────
# Salin file ini menjadi .env lalu sesuaikan nilainya.
# Semua variabel bersifat opsional; aplikasi tetap berjalan dengan nilai default.

# Port server (platform seperti Render/Railway biasanya memberi PORT otomatis)
PORT=3000

# URL publik aplikasi. Dipakai untuk tautan di WhatsApp & kode verifikasi.
# Contoh: https://siprel-elektro.up.railway.app
BASE_URL=

# Lokasi penyimpanan database. Di Docker/Render gunakan folder persisten, mis. /data
DATA_DIR=./data

# Kunci rahasia cookie sesi. WAJIB diganti saat produksi (minimal 32 karakter acak).
SESSION_SECRET=ganti-dengan-kunci-acak-panjang-minimal-32-karakter

# Akun admin yang dibuat otomatis saat database masih kosong.
ADMIN_EMAIL=admin@elektro.uncen.ac.id
ADMIN_PASSWORD=Admin#2026
ADMIN_NAME=Administrator Jurusan

# Isi 0 untuk tidak membuat surat contoh di database baru.
SEED_DEMO=1

# ─── Gateway WhatsApp (opsional) ─────────────────────────────────────────────
# Tanpa gateway, tombol WhatsApp tetap bekerja lewat tautan wa.me (kirim manual
# dari HP admin/petugas). Isi provider + token untuk pengiriman otomatis.
# Pilihan provider: fonnte | wablas | custom
WA_PROVIDER=
WA_TOKEN=
WA_SENDER=
# Hanya untuk provider custom. Gunakan {token} dan {target} sebagai placeholder.
WA_API_URL=
WA_AUTO=0
